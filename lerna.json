{
  "version": "2.0.11",
  "npmClient": "pnpm",
  "useWorkspaces": true,
  "conventionalCommits": true,
  "packages": ["packages/*"],
  "command": {
    "publish": {
      "npmClient": "npm",
      "message": "chore(release): publish %s",
      "registry": "https://registry.npmjs.org"
    },
    "version": {
      "changelogPreset": "angular"
    }
  }
}
